@startuml
title Компоненты онлайн-бэкенда

skinparam backgroundColor #F8FAFC
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 14
skinparam defaultFontColor #0F172A
skinparam titleFontSize 20
skinparam packageTitleAlignment left
skinparam titleFontColor #0F172A
skinparam shadowing false
skinparam linetype polyline
skinparam nodesep 45
skinparam ranksep 50
skinparam roundCorner 12
skinparam ArrowColor #64748B
skinparam ArrowFontColor #475569
skinparam ArrowFontSize 12
skinparam rectangle {
  BorderColor #64748B
  FontColor #0F172A
}

rectangle "Стенд хакатона" as caller #E2E8F0

rectangle "MediDryni · один процесс Python" #FFFFFF {
  rectangle "concierge_service" #EFF6FF {
    rectangle "FastAPI\nPOST /run · GET /health" as http #E0F2FE
    rectangle "RunCase\nSleepPlanner · RequestHandler" as core #DBEAFE
    rectangle "История диалога\nв памяти прогона" as store #FFF7ED
    rectangle "HackApiAdapter · RoomApiAdapter" as adapters #ECFEFF
  }
  rectangle "ai_service\nПредпочтения и намерения" as ai #EDE9FE
}

rectangle "Hack API\nНабор данных" as dataset #FFFFFF
rectangle "Симулятор номера\nСеансы, сценарии, действия" as room #FFFFFF
rectangle "Прокси LLM" as llm #FFFFFF

caller --> http : запускает прогон по HTTP
http --> core : передаёт запрос
core --> ai : <back:#F8FAFC>вызывает AiAgent</back>
core --> adapters : получает данные\nи управляет номером
core --> store : читает и дополняет\nдиалог гостя
adapters --> dataset : загружает набор
adapters --> room : создаёт сеансы, загружает\nсценарии, применяет действия
ai --> llm : отправляет контекст\nдля разбора
@enduml
