@startuml
title Зависимости компонентов: онлайн-прогон и показ

skinparam backgroundColor #F8FAFC
skinparam defaultFontName "Arial"
skinparam titleFontName "Arial"
skinparam defaultFontSize 14
skinparam defaultFontColor #0F172A
skinparam titleFontSize 20
skinparam packageTitleAlignment left
skinparam titleFontColor #0F172A
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 55
skinparam ranksep 85
skinparam roundCorner 12
skinparam ArrowColor #64748B
skinparam ArrowFontColor #475569
skinparam ArrowFontSize 12
skinparam rectangle {
  BorderColor #64748B
  FontColor #0F172A
}

rectangle "Стенд хакатона" as caller #E2E8F0
rectangle "Браузер жюри\nReact-клиент показа" as browser #E2E8F0

rectangle "                                                                                                                                                                                           МедиДруны · один процесс Python" #FFFFFF {
  rectangle "ai_service\nПредпочтения и намерения" as ai #EDE9FE
  rectangle "                                                                                                                                                        concierge_service" #EFF6FF {
    rectangle "FastAPI\nPOST /run · GET /health" as http #E0F2FE
    rectangle "Demo API /api/v1\nвход по коду · сборка клиента" as demohttp #E0F2FE
    rectangle "RunCase\nпрогон набора" as core #DBEAFE
    rectangle "DemoService\nкомната, личный план и часы клиента" as demo #DBEAFE
    rectangle "Общая логика\nSleepPlanner · RequestHandler\nпланировщик действий · каталог устройств" as shared #DBEAFE
    rectangle "В памяти процесса\nдиалог прогона · переписка показа" as store #FFF7ED
    rectangle "HackApiAdapter · RoomApiAdapter\nVoiceProxy" as adapters #ECFEFF
  }
}

rectangle "Внешние системы" #FFFFFF {
  rectangle "Hack API\nНабор данных и прогоны" as dataset #F1F5F9
  rectangle "Симулятор номера\nСеансы, сценарии, действия" as room #F1F5F9
  rectangle "Прокси LLM\nРазбор текста, распознавание и синтез речи" as llm #F1F5F9
}

caller "<color:#FFFFFF>i</color>\n<color:#FFFFFF>i</color>\n<size:1><color:#FFFFFF>i</color></size>\nPOST /run<color:#FFFFFF>i</color>" --> http
browser "<size:1><color:#FFFFFF>i</color></size>\n<size:1><color:#FFFFFF>i</color></size>\n<size:1><color:#FFFFFF>i</color></size>\nвход, чат, голос<color:#FFFFFF>i</color>" --> demohttp
http --> core
demohttp --> demo
core --> shared
demo --> shared : те же просьбы
core --> store
demo --> store
shared --> ai : порт AiAgent<color:#EFF6FF>ii</color>
shared --> adapters
core --> adapters
demo --> adapters
adapters --> dataset
adapters --> room
adapters --> llm : речь<color:#EFF6FF>MMMMii</color>
ai --> "разбор текста" llm
@enduml